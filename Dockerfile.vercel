# syntax=docker/dockerfile:1
#
# Production image for Vercel Docker deployment. Vercel runs only this application
# container — PostgreSQL is NOT bundled here and must be an externally managed instance
# reachable via SPRING_DATASOURCE_URL/USERNAME/PASSWORD (see docs/VERCEL_DEPLOYMENT.md).
#
# Local development is unaffected by this file: it keeps using `docker compose up` (compose.yaml)
# for PostgreSQL plus `./mvnw spring-boot:run` / your IDE for the app itself.

# ──── Build stage ────
FROM eclipse-temurin:25-jdk AS builder

WORKDIR /app

# Copy wrapper + POM first so dependency resolution is cached across builds that only touch src/.
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw

RUN ./mvnw -B dependency:go-offline

COPY src src

RUN ./mvnw -B clean package -DskipTests

# ──── Runtime stage ────
FROM eclipse-temurin:25-jre-alpine

WORKDIR /app

# Run as a non-root user.
RUN addgroup -S spring && adduser -S spring -G spring
COPY --from=builder /app/target/*.jar app.jar
RUN chown spring:spring app.jar
USER spring

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"

# Vercel injects $PORT at runtime; server.port=${PORT:8080} in application.properties binds to
# it. EXPOSE below documents the local-dev default only — it does not fix the runtime port.
EXPOSE 8080

CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
